node_modules/
dist/
.DS_Store
*.log
*.tsbuildinfo

# Local MCP server config - points at machine-specific absolute paths.
# Commit .mcp.json.example instead.
.mcp.json

# Blender asset pipeline: the bpy virtualenv is a multi-hundred-MB local
# toolchain, not project source - build_character.py/build_cashbundle.py are
# what's tracked; run them locally to (re)produce the .glb files if needed.
assets/blender/venv/
assets/blender/*_preview*.png
assets/blender/prop_previews/
assets/blender/family_previews/

# graphify knowledge graph: keep the queryable/readable outputs (graph.json,
# GRAPH_REPORT.md, graph.html, manifest.json, .graphify_root) so the graph
# travels with the branch; ignore the local build cache + intermediate files.
graphify-out/cache/
graphify-out/.graphify_analysis.json
graphify-out/.graphify_labels.json
graphify-out/.graphify_labels.json.sig

# Godot's project data folder: machine-local editor cache, shader cache,
# import metadata and window layout. Versioning it means every pull rewrites
# files underneath a running editor, which is what produced the stacked
# "project data folder is missing" / "files newer on disk" / "no main scene
# defined" dialogs. Godot recreates the folder, and its .gdignore, on open.
godot/.godot/

# Exported builds. Large, machine-specific, and rebuilt from the preset.
build/

# autobuild: generated per run
autobuild/logs/
autobuild/REPORT.md
autobuild/frames/
STOP
# raw downloads the user drops for the loop (zips over GitHub's 100 MB limit);
# what is used gets extracted into godot/art and recorded in ASSETS.md
autobuild/Incoming/
autobuild/incoming/
# P2-1b candidate previews, rebuilt from the zips by tools/convert_character.gd
godot/art/characters/candidates/
