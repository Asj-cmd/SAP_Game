class_name GreyBoxLevel
extends RefCounted
## The arena the grey-box slice plays in, loaded from baked content.
##
## The geometry is generated by tools/build_house.gd into
## game/blockout/house.tscn and baked to a LevelDef by tools/bake_blockout.gd. Nothing here knows a
## coordinate: change the level by dragging boxes and re-baking, not by editing
## this file. That is the same separation WORLD_AUTHORING.md §6 asks for from
## the Blender pipeline, which is why the convention is worth having now - when
## the source moves to a .blend, only the baker changes.
##
## Still plain boxes. The point of the slice is feel, and anything that looks
## finished invites arguing about how it looks instead.

## Safe-room configurations under test. Settling which of these is the better
## game, by playing them, is the whole reason the slice exists.
enum SafeVariant {
	A, ## Sheltered indefinitely, until you grab something.
	B, ## Sheltered for a fixed few seconds, whatever you are carrying.
}

const LEVEL_PATH: String = "res://content/levels/house.tres"
## One mode file per team size: round length, jail time and the rest scale with
## how many bodies a side has, and that is a set of numbers, not code (P0-2c).
const MODE_PATH: String = "res://content/modes/house_%dv%d.tres"
## The grey box seats 1v1 for development; the game ships 2v2 to 4v4 (D8).
const DEFAULT_TEAM_SIZE: int = 1
## Difficulty is a file, not a build. Swapping this path - or editing the .tres
## it points at - is the whole of "make the bots harder".
const BOT_PROFILE_PATH: String = "res://content/ai/bot_profile_standard.tres"

var variant: SafeVariant = SafeVariant.B
var level: LevelDef = null
var zones: Array[ZoneDef] = []
var teams: Array[TeamDef] = []
var collision: WorldCollisionDef = null
## Precomputed by the baker; null falls back to a build at load.
var surface: WalkableSurfaceDef = null
var tuning: TuningDef = null
var mode: GameModeDef = null
var bot_profile: BotProfileDef = null

## `level_path` is overridable so one layout can be measured against another
## without editing anything. Comparing two maps on the same harness is the only
## way a layout metric means anything - a number with nothing to compare it to
## is a number nobody can act on.
func _init(safe_variant: SafeVariant = SafeVariant.B, level_path: String = LEVEL_PATH,
		team_size: int = DEFAULT_TEAM_SIZE) -> void:
	variant = safe_variant
	tuning = build_tuning()
	bot_profile = load(BOT_PROFILE_PATH) as BotProfileDef
	if bot_profile == null:
		push_error("grey box: no bot profile at %s - run tools/write_bot_profiles.gd" % BOT_PROFILE_PATH)

	var baked: LevelDef = load(level_path) as LevelDef
	if baked == null:
		push_error("grey box: no baked level at %s - run tools/bake_blockout.gd" % level_path)
		mode = build_mode(0, team_size)
		return

	# Worked on a copy. The variant switch must not edit the shared asset every
	# other caller is reading - and a runtime edit of content would be
	# presentation writing into the layer the rules read.
	level = baked.duplicated()
	_apply_variant()
	zones = level.zones
	teams = level.teams
	collision = level.collision
	surface = level.surface
	mode = build_mode(_cash_per_team(), team_size)

## Numbers a designer dials, kept apart from the geometry a designer drags.
##
## ONLY THE DIFFERENCES FROM TuningDef's OWN DEFAULTS BELONG HERE, and that is a
## rule learned the hard way. This function used to restate values it agreed
## with - actor_radius, move_speed, gravity, step_up_height - and one it no
## longer did: carry_speed_scale sat at 1.0 here for months after the default
## became 0.85, so laden actors ran at full speed and carrying cash cost
## nothing. Nobody could see it, because the tuning file said 0.85 and was
## telling the truth about itself.
##
## A restated value is a value that silently stops tracking the thing it
## restates. If a number here matches the default, delete it.
static func build_tuning() -> TuningDef:
	var values: TuningDef = TuningDef.new()
	# Tighter than the defaults on purpose: the grey box is a small, dense
	# space, and reach that feels right in a house makes every interaction in
	# here trigger from across the room. Playtest numbers, not arbitrary ones.
	values.pickup_range = 70.0
	values.capture_range = 80.0
	values.rescue_range = 80.0
	return values

## The rules for `team_size` a side, from its mode file.
##
## A copy, because the cash count is stamped onto it from the level and the
## shared asset must not be edited at runtime. The cash count is the one number
## not in the file: it comes from the markers, so moving cash in the blockout
## cannot leave the win target describing a different game. The 1v1 file's
## jail time (18 s) is a playtest number: eight seconds was nothing, sixty was
## most of a round.
static func build_mode(cash_per_team: int, team_size: int = DEFAULT_TEAM_SIZE) -> GameModeDef:
	var path: String = MODE_PATH % [team_size, team_size]
	var authored: GameModeDef = load(path) as GameModeDef if ResourceLoader.exists(path) else null
	if authored == null:
		push_error("grey box: no mode for %dv%d at %s" % [team_size, team_size, path])
		authored = GameModeDef.new()
		authored.team_size = team_size
	var rules: GameModeDef = authored.duplicate() as GameModeDef
	rules.cash_per_team = cash_per_team
	return rules

## The A/B question, expressed entirely as content values. Nothing outside this
## function - and nothing in the HUD - restates them (§9).
func _apply_variant() -> void:
	for zone: ZoneDef in level.sheltered_zones():
		if variant == SafeVariant.A:
			zone.safe_duration_seconds = -1.0
			zone.safe_ends_on_pickup = true
		else:
			zone.safe_duration_seconds = 5.0
			zone.safe_ends_on_pickup = false

## Taken from the level rather than declared, so moving cash markers in the
## blockout cannot leave the win target describing a different game.
func _cash_per_team() -> int:
	var most: int = 0
	for team: TeamDef in teams:
		most = maxi(most, team.cash_points.size())
	return most

## The sheltered room the variant question is about, for the HUD to read its
## numbers from rather than restate them.
func sheltered_zone() -> ZoneDef:
	if level == null:
		return null
	var sheltered: Array[ZoneDef] = level.sheltered_zones()
	return sheltered[0] if not sheltered.is_empty() else null

func is_loaded() -> bool:
	return level != null and collision != null
